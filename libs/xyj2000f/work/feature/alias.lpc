// cracked by vikee 2/09/2002   vikee@263.net
// alias.c

#define MAX_REPEAT 50
#define MAX_ALIASES 40
#define HISTORY_BUFFER_SIZE 10

mapping alias;

nosave string *history, last_input;
nosave int last_cmd, repeat_cnt = 0;
nosave int last_time = time(), cmd_cnt = 0, cmd_cnt1 = 0, cmd_cnt2 = 0;

// Pending commands from a ";" chain or a "#" repeat, drained one per
// call_out so the batch can't trip the anti-flood guard above.
nosave string *cmd_queue = ({});

// Seconds already spent waiting for the CURRENT queued command to become
// runnable. Non-instant actions (dazuo/exercise, meditate, learn, xiudao,
// chanting, steal, sleep ...) call start_busy() and return immediately,
// so a repeat has to wait for the action to finish instead of firing on
// the next tick and failing with 你的动作还没有完成.
nosave int queue_waited;

#define MAX_QUEUE_WAIT 30   // seconds to wait per command before giving up

string resolve_alias(string str);

// speed of player input commands.
int query_cmd_count() { return cmd_cnt2; }

int query_queued_commands() { return sizeof(cmd_queue); }

void clear_cmd_queue() { cmd_queue = ({}); }

// "look#3" -> ({ "look", "look", "look" }). Anything without a positive
// integer suffix passes through untouched, so a literal '#' inside a
// normal command (a channel message, say) is left alone.
private string *expand_repeat(string cmd) {
  string base;
  int n, i;
  string *out;

  if (sscanf(cmd, "%s#%d", base, n) != 2) return ({ cmd });
  if (n < 1) return ({ base });
  // Never repeat an irreversible command -- a typo shouldn't be able to
  // run it 50 times.
  if (base == "suicide" || resolve_alias(base) == "suicide")
    return ({ base });
  // Reuse the file's existing ceiling rather than inventing a second one.
  if (n > MAX_REPEAT) n = MAX_REPEAT;

  out = ({});
  for (i = 0; i < n; i++) out += ({ base });
  return out;
}

// Split on ";" then expand each part's "#N". Returns the full command
// list in left-to-right order.
private string *parse_batch(string str) {
  string *parts, *out;
  int i;

  parts = explode(str, ";");
  out = ({});
  for (i = 0; i < sizeof(parts); i++) {
    string p = parts[i];
    // Tolerate spaces around the separator: "w; e ;s".
    while (strlen(p) && p[0] == ' ') p = p[1..];
    while (strlen(p) && p[strlen(p) - 1] == ' ') p = p[0..strlen(p) - 2];
    if (!strlen(p)) continue;
    out += expand_repeat(p);
  }
  return out;
}

// Runs the next queued command. Stops the whole batch if the player has
// been pulled into combat, or if the command itself failed -- every
// failure path here (blocked exit, "你的动作还没有完成", over-encumbered,
// no_move) goes through notify_fail(), which makes command() return 0.
// Continuing past a blocked step would scatter the character somewhere
// unintended, which is worse than stopping short.
void run_queued_command() {
  object me = this_object();
  string next;

  if (!me || !sizeof(cmd_queue)) return;

  if (me->is_fighting()) {
    cmd_queue = ({});
    queue_waited = 0;
    tell_object(me, "（战斗中，后续指令已取消。）\n");
    return;
  }

  // Wait, don't fail, while the previous action is still running or the
  // player is answering a prompt. is_busy() covers every start_busy()
  // action; in_input() covers commands that read a reply (passwd,
  // abandon, observe) -- firing into those would feed queued commands to
  // the prompt as if they were answers.
  // is_busy() is not the whole story: several commands track "action
  // still running" with their own pending/* temp flag as well, and
  // exercise/meditate refuse to start again while theirs is set. Waiting
  // on is_busy() alone made dazuo#3 fail on the second repetition with
  // 你现在正忙着呢.
  if (me->is_busy() || in_input(me)
    || me->query_temp("pending/exercising")
    || me->query_temp("pending/meditating")
    || me->query_temp("pending/sleep")) {
    if (queue_waited >= MAX_QUEUE_WAIT) {
      cmd_queue = ({});
      queue_waited = 0;
      tell_object(me, sprintf("（等了 %d 秒仍无法继续，"
        "后续指令已取消。）\n", MAX_QUEUE_WAIT));
      return;
    }
    queue_waited++;
    call_out("run_queued_command", 1);
    return;
  }

  next = cmd_queue[0];
  cmd_queue = cmd_queue[1..];
  queue_waited = 0;

  if (!command(resolve_alias(next))) {
    cmd_queue = ({});
    tell_object(me, "（「" + next + "」无法执行，后续指令已取消。）\n");
    return;
  }

  // 1s rather than 0s: the action just issued may only set its busy flag
  // on the next heartbeat, and checking too early would race it.
  if (sizeof(cmd_queue)) call_out("run_queued_command", 1);
}

string process_input(string str) {
  int i, curr_time;

  if (userp(this_object()) && (this_object()->query_temp("block_msg/all")
    || !living(this_object())))
    return "";

  notify_fail("什么？\n");  // default fail messages.
  // for both gb and big5 environment.
  // need to be set here. otherwise big5 
  // will not show it correctly.
  // mon 5/12/98

  reset_eval_cost();
  // added by mon 5/18/98 to clear up eval_counter.
  // it seems that if one input many commands in a raw,
  // then the eval_counter is not cleared in time, and
  // thus causing Too long evaluation error.

  str = CONVERT_D->input(str, this_object());

  // by mon 7/19/97. command counting.
  cmd_cnt++;
  if (cmd_cnt > 100) {  //threshold for how many commands can be
    //input every few seconds.(determined below)
    curr_time = time();
    if (curr_time - last_time < 5) {
      if (cmd_cnt1 == 0) {
        cmd_cnt2 = cmd_cnt / (curr_time - last_time + 1);
        write("你一次输入太多命令了。\n");
      }
      cmd_cnt1++;
      if (cmd_cnt1 > 30) cmd_cnt1 = 0;
      last_time = curr_time;
      //in case of flooding, has to wait a few
      //seconds without input to be able to
      //input again.
      return "";  //flooding detected. ignore input.
    } else {
      cmd_cnt2 = cmd_cnt / (curr_time - last_time + 1);
      last_time = curr_time;
      cmd_cnt = 0;
      cmd_cnt1 = 0;
    }
  }

  // mon 10/10/98 removed the following checks
  // since it is easy to work around this and no
  // real effect.
  /*
	if( str==last_input && strlen(str)==0 ) {
		repeat_cnt++;
		if( repeat_cnt > MAX_REPEAT ) {
			tell_object( this_object(),
		"\n\n忽听一声惨叫，从你脑门上爬下一只害虫，飞也似地逃走了。\n"+
		"\n一边跑一边恨恨地道：原来是个机器人，牙都给崩掉了．．．\n\n");
command("rumor 忽听一声惨叫，从"+this_player()->name()+
        "脑门上爬下一只害虫，飞也似地逃走了。 ");
command("rumor 害虫一边跑一边恨恨地道：原来是个机器人，牙都给崩掉了．．．");
         this_player()->set("sen",-1);
         command("quit");
		}
	} else {
		repeat_cnt = 0;
		last_input = str;
	}
	*/

  if (str[0] == '!') {
    if (pointerp(history) && sizeof(history)) {
      if (sscanf(str, "!%d", i)) {
        if (i < 0) i = 0;
        else i = i % HISTORY_BUFFER_SIZE;
        str = (string)history[(HISTORY_BUFFER_SIZE + last_cmd - i) % HISTORY_BUFFER_SIZE];
      } else
        str = history[last_cmd];
      if (!str) return "";
    } else
      return "";
  } else {
    if (!pointerp(history)) history = allocate(HISTORY_BUFFER_SIZE);
    last_cmd = (last_cmd + 1) % HISTORY_BUFFER_SIZE;
    history[last_cmd] = str;
  }

  // A fresh line from the player cancels any batch still in flight, so
  // typing something is always enough to regain control.
  if (sizeof(cmd_queue)) cmd_queue = ({});

  if (strsrch(str, ';') != -1 || strsrch(str, '#') != -1) {
    string *batch = parse_batch(str);

    if (sizeof(batch) > 1) {
      // Queue the WHOLE batch, including the first command, and hand the
      // driver an empty string. Running the first one here instead would
      // hide its success/failure from run_queued_command(), so a chain
      // whose opening step was blocked would carry on regardless.
      cmd_queue = batch;
      queue_waited = 0;
      call_out("run_queued_command", 0);
      return "";
    }
    if (sizeof(batch) == 1) str = batch[0];
  }

  return resolve_alias(str);
}

// Alias expansion, split out of process_input() so queued commands get
// the same treatment (so "n" still becomes "go north") without being
// counted again by the anti-flood guard.
string resolve_alias(string str) {
  string *args, cmd, argstr;
  int i, j;

  if (mapp(alias)) {

    if (!undefinedp(alias[str]))
      return replace_string(alias[str], "$*", "");

    if (sscanf(str, "%s %s", cmd, argstr) == 2 && !undefinedp(alias[cmd])) {
      cmd = replace_string(alias[cmd], "$*", argstr);
      args = explode(argstr, " ");
      if ((j = sizeof(args)))
        for (i = 0; i < j; i++)
          cmd = replace_string(cmd, "$" + (i + 1), args[i]);
      return cmd;
    }
  }

  return (string)ALIAS_D->process_global_alias(str);
}

int set_alias(string verb, string replace) {
  if (!replace) {
    if (mapp(alias)) map_delete(alias, verb);
    return 1;
  } else {
    if (!mapp(alias)) alias = ([ verb: replace ]);
    else if (sizeof(alias) > MAX_ALIASES)
      return notify_fail("您设定的 alias 太多了，请先删掉一些不常用的。\n");
    else alias[verb] = replace;
    return 1;
  }
}

mapping query_all_alias() {
  return alias;
}
