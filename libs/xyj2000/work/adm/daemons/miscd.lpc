#pragma optimize

#include <ansi.h>

inherit F_DBASE;

mapping maps = ([]);

void create() {
  string filename = __DIR__ "find.map";
  string buf, *buf1;
  string dir, name;
  int size, i;

  seteuid(getuid());
  set("name", "监控精灵");
  set("id", "miscd");

  maps = ([]);

  buf = read_file(filename);
  if (!buf) {
    // Silent failure here degrades every location the mud reports into a
    // bare room name -- 休息室, 山路, 大官道 -- which is exactly what
    // 袁天罡's 灭妖 assignment must never say. Make it visible.
    // catch(): this is create() in a PRELOADED daemon (adm/etc/preload:19)
    // and log_file() is a bare write_file() (adm/simul_efun/file.lpc:8), so
    // a missing /log throws at boot. AGENTS.md 7.11.
    catch(log_file("miscd", "find.map 读不到（" + filename + "），"
      "所有地点都会退化成房间名。\n"));
    return;  //no data available.
  }

  buf1 = explode(buf, "\n");
  size = sizeof(buf1);
  if (!size) return;

  for (i = 0; i < size; i++) {
    if (sscanf(buf1[i], "%s %s", dir, name) == 2) {
      name = replace_string(name, " ", "");
      name = replace_string(name, "\r", "");
      if (strlen(dir) > 2 && strlen(name) > 2) {
        maps += ([ dir: name ]);
      }
    }
  }

  if (!sizeof(maps))
    catch(log_file("miscd", "find.map 解析出 0 条地区名（" + filename + "）。\n"));
}

int random_capture(object me, int chance, int silent) {
  if (!me) return 0;
  if (!chance) chance = 5000;
  //	if(wizardp(me)) chance=1;

  if (random(chance) == 0) {
    if (silent)
      tell_object(me, "\n忽然一阵黄风呼啸而来，你身不由己" +
        "被卷了进去！\n");
    else
      message_vision("\n忽然一阵黄风呼啸而来，$N身不由己" +
        "被卷了进去！\n", me);
    tell_object(me, "\n不知过了多久．．．\n\n");
    me->set_temp("old_place", environment(me));
    me->move("/d/qujing/baihuling/jail", 1);
    message_vision("$N被嘭地一声摔在地上！\n", me);
    return 1;
  }
  return 0;
}


// The AREA an object is in, from find.map -- never the name of a single
// room. Returns 0 when nothing on the path is named, so callers can
// decide what to do about it.
//
// Three things this handles that the old inline lookup in find_place()
// did not:
//   - file_name() may or may not come back with a leading '/' depending
//     on the driver, so normalise instead of assuming one;
//   - the lookup was for the room's EXACT directory, so a room in a
//     subdirectory of a named area (d/moon/quest, d/city/misc,
//     d/changan/playerhomes) missed and fell through to its own short
//     name -- walk up the tree instead;
//   - a clone id on the end (/obj/home#123) sits after the last '/', so
//     the directory part is unaffected either way.
string find_area(object where) {
  string filename, label;
  int len;

  if (!where) return 0;

  filename = file_name(where);
  if (!stringp(filename) || strlen(filename) < 2) return 0;
  if (filename[0] != '/') filename = "/" + filename;

  len = strlen(filename) - 1;
  while (len > 1) {
    while (len > 1 && filename[len] != '/') len--;
    if (len < 2) return 0;
    label = maps[filename[1..(len - 1)]];
    if (stringp(label) && strlen(label)) return label;
    len--;
  }
  return 0;
}

string find_place(object where) {
  string fail, filename, answer;

  fail = "";  // default fail message

  if (!where) return fail;

  filename = file_name(where);
  if (!stringp(filename) || strlen(filename) < 2) return fail;
  if (filename[0] != '/') filename = "/" + filename;

  if (sscanf(filename, "/d/changan/bed#%*s") == 1)
    //this need check first.
    return "床上";

  answer = find_area(where);
  if (stringp(answer) && strlen(answer)) return answer;

  if (where->is_character())
    return where->query("name") + "身上";

  if (sscanf(filename, "/obj/home#%*s") == 1)
    return "住家里";

  return undefinedp(where->query("short")) ? where->short() : where->query("short");
}

